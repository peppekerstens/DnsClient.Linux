<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>DnsClient.Linux</id>
    <version>0.1.0</version>
    <authors>peppekerstens</authors>
    <description>PowerShell module for Linux providing cmdlet parity with the Windows DnsClient module. Implements Resolve-DnsName, Clear-DnsClientCache, Get-DnsClientServerAddress, Get-DnsClientGlobalSetting using dig and resolvectl.</description>
    <tags>PowerShell Linux pwsh Module DnsClient</tags>
    <projectUrl>https://github.com/peppekerstens/DnsClient.Linux</projectUrl>
    <license type="expression">GPL-3.0-only</license>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
  </metadata>
  <files>
    <file src="DnsClient.Linux\**\*" target="DnsClient.Linux" />
    <file src="PSScriptAnalyzerSettings.psd1" target="DnsClient.Linux" />
  </files>
</package>


